# ============================================================================
# EUREKA — environment variables
# ----------------------------------------------------------------------------
# Copy to .env and fill in. Do NOT commit .env (already in .gitignore).
# In Sevalla, set these as the production env vars on the static site.
# ============================================================================

# TinaCMS Cloud credentials — get from https://app.tina.io
# 1. Sign in with GitHub
# 2. Create a new project, connect this repo
# 3. Copy the Client ID + a Read-Only Token from the project settings
TINA_CLIENT_ID=
TINA_TOKEN=

# Optional: which branch Tina commits to. Defaults to "main" if unset.
# GITHUB_BRANCH=main

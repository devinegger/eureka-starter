permalink: /styles.css
---

:root {
  color-scheme: light;
  --bg: #f6f0e7;
  --panel: #fffaf3;
  --panel-strong: #fff4e8;
  --text: #1f1915;
  --muted: #6f6257;
  --line: #ddcfbd;
  --accent: #a14813;
  --accent-strong: #7f3305;
  --shadow: 0 20px 45px rgba(85, 51, 21, 0.08);
  --radius: 20px;
  --content: 72rem;
}

* {
  box-sizing: border-box;
}

html {
  margin: 0;
  background:
    radial-gradient(circle at top left, rgba(255, 210, 170, 0.45), transparent 32rem),
    linear-gradient(180deg, #fbf7f1 0%, var(--bg) 100%);
  color: var(--text);
  font-family: Georgia, "Iowan Old Style", "Palatino Linotype", "Book Antiqua", serif;
  line-height: 1.6;
}

body {
  margin: 0;
}

a {
  color: var(--accent-strong);
}

a:hover {
  color: var(--accent);
}

.shell {
  width: min(calc(100% - 2rem), var(--content));
  margin: 0 auto;
}

.site-header {
  padding: 1rem 0;
}

.site-header .shell {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-size: 1.1rem;
  font-weight: 700;
  text-decoration: none;
  letter-spacing: 0.02em;
}

.site-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
}

.site-nav a {
  text-decoration: none;
}

.hero {
  padding: 2rem 0 1.5rem;
}

.hero-card,
.content-card {
  background: linear-gradient(180deg, var(--panel) 0%, white 100%);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.hero-card {
  padding: 2rem;
}

.eyebrow {
  margin: 0 0 0.75rem;
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-card h1,
.content-card h1:first-child {
  margin-top: 0;
}

.hero-copy {
  max-width: 45rem;
  color: var(--muted);
  font-size: 1.05rem;
}

.content {
  padding-bottom: 3rem;
}

.content-card {
  padding: 2rem;
}

.content-card h2,
.content-card h3 {
  margin-top: 1.6em;
}

.content-card p,
.content-card li {
  max-width: 65ch;
}

.section-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
}

.section-list a {
  display: block;
  padding: 1rem;
  background: var(--panel-strong);
  border: 1px solid var(--line);
  border-radius: 1rem;
  text-decoration: none;
}

.section-list a strong {
  display: block;
  margin-bottom: 0.25rem;
}

.meta-note {
  color: var(--muted);
  font-size: 0.95rem;
}

.site-footer {
  padding: 0 0 2rem;
  color: var(--muted);
}

@media (max-width: 640px) {
  .hero-card,
  .content-card {
    padding: 1.25rem;
    border-radius: 1rem;
  }

  .hero {
    padding-top: 1rem;
  }
}

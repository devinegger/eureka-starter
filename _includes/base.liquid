<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.name | default: "Your Site" }}</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/">{{ site.name | default: "Your Site" }}</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/demo-project/">Demo Project</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="shell">
          <div class="hero-card">
            <h1>{{ title | default: site.name | default: "Your Site" }}</h1>
            <div class="hero-copy">
              {{ description | default: "A Markdown-first site built with Eleventy." }}
            </div>
          </div>
        </div>
      </section>

      <section class="content">
        <div class="shell">
          <article class="content-card">
            {{ content }}
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p class="meta-note">Edit Markdown files and keep parent <code>index.md</code> links current.</p>
      </div>
    </footer>
  </body>
</html>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}Codex Exploration Demo</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/">Codex Exploration Demo</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/demo-project/">Demo Project</a>
          <a href="/weekly-notes/">Weekly Notes</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="shell">
          <div class="hero-card">
            <p class="eyebrow">Stock 11ty Starter</p>
            <h1>{{ title | default: "Codex Exploration Demo" }}</h1>
            <div class="hero-copy">
              {{ description | default: "A simple Markdown-first site structure with nested folders, shared Liquid layout, and no custom Eleventy scripting." }}
            </div>
          </div>
        </div>
      </section>

      <section class="content">
        <div class="shell">
          <article class="content-card">
            {{ content }}
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p class="meta-note">Edit Markdown files, keep parent <code>index.md</code> links current, and use <code>.gitignore</code> for content that should stay out of the site.</p>
      </div>
    </footer>
  </body>
</html>

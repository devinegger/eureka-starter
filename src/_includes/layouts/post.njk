---
layout: layouts/base.njk
---

<article>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{{ date | readableDate }}{% if author %} · {{ author }}{% endif %}</p>
      <h1 class="page-hero__title">{{ title }}</h1>
      {% if description %}<p class="page-hero__sub">{{ description }}</p>{% endif %}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        {{ content | safe }}
      </div>
    </div>
  </section>
</article>

{% include "partials/cta-block.njk" %}

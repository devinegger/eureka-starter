<!doctype html>
<html lang="en" data-theme="{{ site.theme | default('dark') }}" data-brand="{{ site.brand | default('default') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="{{ site.theme | default('dark') }}">

  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) }}">

  <link rel="stylesheet" href="/assets/css/main.css">

  {# Cloudflare Turnstile — loaded on pages with a form #}
  {% if hasContactForm %}
    {# TODO: replace placeholder data-sitekey when CF Turnstile is provisioned. #}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Open Graph #}
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

{% include "partials/nav.njk" %}

<main id="main">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/assets/js/nav-mobile.js" defer></script>
{% if hasPagespeedWidget %}<script src="/assets/js/pagespeed-widget.js" defer></script>{% endif %}
{% if hasContactForm %}<script src="/assets/js/contact-form.js" defer></script>{% endif %}

</body>
</html>

{{!--
  Widget slot. Reads its config from either:
    - This block's inline fields (Tina blocks dispatcher path):
        { _template: "widget-slot", widget, widgetEyebrow, widgetTitle, ... }
    - Page-level frontmatter (legacy sections-array path):
        widget: pagespeed-checker
        widgetEyebrow: Free site audit
        widgetTitle: How fast is your site, really?
        ...

  Detects which by checking whether `widget` exists on the immediate
  context. If yes → block path. If no → legacy path, read from @root.
  (Legacy path is the case when `_template` is absent.)
--}}
{{#if _template}}
  {{!-- BLOCK PATH: this = block, fields are at top level --}}
  <section class="section widget-slot" id="audit" aria-labelledby="widgetTitle">
    <div class="container">
      <div class="widget-slot__header">
        <div>
          {{#if widgetEyebrow}}<p class="eyebrow">{{widgetEyebrow}}</p>{{/if}}
          <h2 class="section-title widget-slot__title" id="widgetTitle">{{widgetTitle}}</h2>
          {{#if widgetLede}}<p class="section-lede">{{widgetLede}}</p>{{/if}}
        </div>
        {{#if widgetMeta}}
        <div class="widget-slot__meta">
          <span class="dot" aria-hidden="true"></span>
          <span>{{widgetMeta}}</span>
        </div>
        {{/if}}
      </div>
      {{#if (eq widget "pagespeed-checker")}}
        {{> widgets/pagespeed-checker}}
      {{else if (eq widget "roi-calculator")}}
        {{> widgets/roi-calculator}}
      {{else}}
        <div class="ps__empty">
          <div class="ps__empty-icon">// Unknown widget: "{{widget}}"</div>
        </div>
      {{/if}}
    </div>
  </section>
{{else}}
  {{!-- LEGACY PATH: this = @root, widget config at root level --}}
  <section class="section widget-slot" id="audit" aria-labelledby="widgetTitle">
    <div class="container">
      <div class="widget-slot__header">
        <div>
          {{#if widgetEyebrow}}<p class="eyebrow">{{widgetEyebrow}}</p>{{/if}}
          <h2 class="section-title widget-slot__title" id="widgetTitle">{{widgetTitle}}</h2>
          {{#if widgetLede}}<p class="section-lede">{{widgetLede}}</p>{{/if}}
        </div>
        {{#if widgetMeta}}
        <div class="widget-slot__meta">
          <span class="dot" aria-hidden="true"></span>
          <span>{{widgetMeta}}</span>
        </div>
        {{/if}}
      </div>
      {{#if (eq widget "pagespeed-checker")}}
        {{> widgets/pagespeed-checker}}
      {{else if (eq widget "roi-calculator")}}
        {{> widgets/roi-calculator}}
      {{else}}
        <div class="ps__empty">
          <div class="ps__empty-icon">// Unknown widget: "{{widget}}"</div>
        </div>
      {{/if}}
    </div>
  </section>
{{/if}}

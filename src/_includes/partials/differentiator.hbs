{{!-- Methodology block. Consumes _data/differentiator.json. --}}
<section class="section section--warm differentiator" aria-labelledby="diffTitle">
  <div class="container">
    <div class="differentiator__grid">
      <div>
        <p class="eyebrow">{{differentiator.eyebrow}}</p>
        <h2 class="section-title" id="diffTitle">{{differentiator.title}}</h2>
        <p class="section-lede">{{differentiator.lede}}</p>
      </div>
      <div>
        <ol class="diff-list">
          {{#each differentiator.items}}
            <li>
              <span class="diff-list__num">{{add @index 1}}</span>
              <div>
                <p class="diff-list__head">{{this.head}}</p>
                <p class="diff-list__body">{{this.body}}</p>
              </div>
            </li>
          {{/each}}
        </ol>
        <a href="{{differentiator.ctaUrl}}" class="btn btn--primary">
          {{differentiator.ctaLabel}}
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

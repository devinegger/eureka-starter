{{!-- Grid of service areas, linking each to its detail page. --}}
<section class="section">
  <div class="container">
    <p class="eyebrow">Markets</p>
    <h2 class="section-title">Where we work today.</h2>
    <p class="section-lede">Don't see your city? We probably still serve it — get in touch.</p>

    <div class="services__grid services__grid--expanded">
      {{#each serviceAreas.items}}
        <a class="service-card" href="/service-areas/{{this.slug}}/">
          <div class="service-card__index">{{this.state}}</div>
          <h3 class="service-card__title">{{this.city}}</h3>
          <p class="service-card__body">{{this.tagline}}</p>
          <span class="service-card__cta">Learn more <span class="arrow" aria-hidden="true">&rarr;</span></span>
        </a>
      {{/each}}
    </div>
  </div>
</section>

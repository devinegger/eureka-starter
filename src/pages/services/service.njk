---
layout: layouts/landing.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "/services/{{ service.slug }}/"
eleventyComputed:
  title: "{{ service.title }}"
  description: "{{ service.summary }}"
hasContactForm: true
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Service / {{ service.index }}</p>
    <h1 class="page-hero__title">{{ service.hero }}</h1>
    <p class="page-hero__sub">{{ service.lede }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="differentiator__grid">
      <div>
        <p class="eyebrow">What’s included</p>
        <h2 class="section-title">Everything you get with {{ service.shortName | lower }}.</h2>
        <p class="section-lede">Scoped, flat-fee, no surprise add-ons. Anything not on this list is out of scope until we both agree to add it.</p>
      </div>
      <div>
        <ul class="feature-list">
          {% for inc in service.includes %}
            <li>{{ inc }}</li>
          {% endfor %}
        </ul>

        <div class="pricing-band">
          <div class="pricing-band__label">{{ service.pricing.label }}</div>
          <div class="pricing-band__amount">{{ service.pricing.amount }}</div>
          <p class="pricing-band__note">{{ service.pricing.note }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "partials/process-steps.njk" %}

<section class="section section--warm">
  <div class="container">
    <p class="eyebrow">Common questions</p>
    <h2 class="section-title">Things owners always ask.</h2>
    <div class="faq-list">
      {% for f in service.faq %}
        <details class="faq-item">
          <summary>{{ f.q }}</summary>
          <div class="faq-item__body">{{ f.a }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% include "partials/cta-block.njk" %}
